# ---------------------------------------------------------------------------
# Workshop Zero - line endings and art attributes
# ---------------------------------------------------------------------------

* text=auto eol=lf

# Luau / Lua sources stay diffable plain text.
*.lua text eol=lf
*.luau text eol=lf

# Roblox place snapshots: .rbxlx is XML on purpose (diffable, versioned).
*.rbxlx text eol=lf

# Roblox binary formats are not line-based.
*.rbxl binary
*.rbxm binary

# ---------------------------------------------------------------------------
# Large binary art - committed directly, not through Git LFS
# ---------------------------------------------------------------------------
# Git LFS routing was removed because the GitHub account's LFS budget is
# exhausted, which blocks every LFS push with "This repository exceeded its
# LFS budget". Direct objects cost nothing and work for any single file under
# GitHub's 100 MB per-file push limit. Every asset in this project is well
# under that (largest is wall_panel_01/base.obj at about 56 MB).
#
# If a single art file above 100 MB is ever needed, restore `filter=lfs` for
# that format and fix the account's LFS budget first.
*.blend binary
*.glb binary
*.gltf text eol=lf
*.fbx binary
*.obj text eol=lf
*.stl binary
*.psd binary
*.exr binary

# PNG/JPG texture art is committed directly as well, so keep single files
# under the same 100 MB limit.
*.png binary
*.jpg binary
*.jpeg binary
