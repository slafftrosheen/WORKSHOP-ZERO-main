# ---------------------------------------------------------------------------
# Workshop Zero - line endings and Git LFS routing
# ---------------------------------------------------------------------------

* text=auto eol=lf

# Luau / Lua sources stay diffable plain text.
*.lua text eol=lf
*.luau text eol=lf

# Roblox place snapshots: .rbxlx is XML on purpose (diffable, versioned).
*.rbxlx text eol=lf

# Roblox binary formats are not line-based.
*.rbxl binary
*.rbxm binary

# ---------------------------------------------------------------------------
# Git LFS - large binary art source
# ---------------------------------------------------------------------------
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Small PNG/JPG UI art stays as regular Git objects so it remains practical
# to diff and review. Move large generated textures to LFS selectively later.
*.png binary
*.jpg binary
*.jpeg binary
